{
  "name": "deskpet",
  "version": "1.0.0",
  "description": "桌面宠物应用",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "start:mac": "open -na \"$PWD/node_modules/electron/dist/Electron.app\" --args \"$PWD\"",
    "dev": "electron .",
    "build": "electron-builder",
    "test": "node test/skin-utils.test.js && node test/no-gamification.test.js && node test/pet-state.test.js && node test/avatar-ui.test.js && node test/codex-home-ui.test.js"
  },
  "keywords": [
    "desktop",
    "pet",
    "electron"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^28.2.3",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.deskpet.app",
    "productName": "小窝桌宠",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/tray.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
